{
  "compilerOptions": {
    "module": "ES2022",
    "target": "ES2022",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "outDir": "build",
    "paths": {
      "@/*": ["./src/*"]
    }
  },  
  "ts-node": {
    "esm": true, 
    "experimentalSpecifierResolution": "node",
  }, 
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": ["node_modules"], 
}
