{
  "compilerOptions": {
    "target": "es2021",              
    "lib": [
      "ES2021.String"
    ],          
    "module": "commonjs",                           
    "esModuleInterop": true,                          
    "forceConsistentCasingInFileNames": true,         
    "strict": true,                                     
    "skipLibCheck": true ,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "paths": {
      "@/*": ["./src/*"]
    }
  },  
  "ts-node": {
    "esm": true, 
  }, 
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": ["node_modules"] 
}
